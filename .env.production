# Production build configuration for the public website.
#
# Vite loads this file automatically for `vite build` (Vercel's build), and
# NOT for `npm run dev`, which keeps using .env.local -> http://localhost:4000.
#
# This is not a secret: the value is compiled into the public JS bundle and is
# visible to every visitor. It is committed so production does not depend on a
# Vercel dashboard variable. A VITE_API_URL set in the Vercel dashboard still
# takes precedence over this file.
#
# No trailing slash — src/lib/api.ts appends "/api".
VITE_API_URL=https://hanxcel-api.onrender.com
