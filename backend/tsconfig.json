{
  "compilerOptions": {
    "target": "ES2022",
    // Node16 keeps CommonJS emit (package.json has "type": "commonjs") while
    // using the resolver Node actually implements. The older "node"/"node10"
    // setting was removed in TypeScript 7, which is what newer editors bundle.
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
