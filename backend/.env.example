# ---------------------------------------------------------------
# Hanxcel backend environment
# Copy to `.env` and fill in the real values. Never commit `.env`.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Secret. Bypasses Row Level Security — server-side only, never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Allowed CORS origins. localhost:3000 / :3001 are always permitted when NODE_ENV != production.
FRONTEND_URL=https://hanxcel.vercel.app
ADMIN_URL=https://hanxcel-admin.vercel.app

PORT=4000
NODE_ENV=development
